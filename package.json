{
  "name": "english-tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/*.browser.mjs",
    "prepare:articles": "node scripts/prepare-article.mjs effective-harnesses && node scripts/prepare-article.mjs harness-design",
    "prepare:model": "node translation.mjs --download-model",
    "prepare:book": "node scripts/prepare-book.mjs",
    "interests": "node scripts/interests.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "parse5": "8.0.0",
    "sharp": "0.35.5",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3"
  },
  "description": "A self-hosted reader for learning English through your own reading."
}
